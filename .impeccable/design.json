      "html": "<div class=\"ds-switch\"><button aria-pressed=\"true\">Children</button><button data-audience=\"adult\" aria-pressed=\"false\">Adults</button></div>",
      "css": ".ds-switch{display:flex;gap:6px;padding:5px;background:#080e16;border:1px solid #42657b;border-radius:0}.ds-switch button{min-height:44px;padding:10px 20px;border:0;border-radius:0;background:transparent;color:#d8eaf4;font:14px Inter,sans-serif}.ds-switch button[aria-pressed=\"true\"]{background:#00b0e0;color:#031322}.ds-switch button[data-audience=\"adult\"][aria-pressed=\"true\"]{background:#f49abc;color:#281020}.ds-switch button:hover{outline:1px solid #81def6}.ds-switch button:focus-visible{outline:2px solid #48b5dd;outline-offset:5px}"
