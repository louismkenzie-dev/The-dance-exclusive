      "css": ".ds-motion{display:flex;gap:8px;align-items:center;min-height:40px;padding:10px 16px;border:1px solid #080e16;border-radius:0;background:#48b5dd;color:#080e16;font:10px/1 \"SFMono-Regular\",Consolas,\"Liberation Mono\",monospace;text-transform:uppercase}.ds-motion:hover{background:#080e16;color:#48b5dd}.ds-motion:disabled{cursor:default}.ds-motion:focus-visible{outline:2px solid #080e16;outline-offset:-4px}"
