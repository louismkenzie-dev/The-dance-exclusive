      "html": "<nav class=\"ds-nav\" aria-label=\"Sample navigation\"><a href=\"#children\">Children</a><a href=\"#adult\">Adults</a><a href=\"#locations\">Locations</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-evenly;gap:16px;padding:0 20px;background:#48b5dd;color:#080e16;font:12px/1 \"SFMono-Regular\",Consolas,\"Liberation Mono\",monospace;text-transform:uppercase}.ds-nav a{padding:20px 0;color:inherit;text-decoration:none;transition:color .2s}.ds-nav a:hover{text-decoration:underline;text-underline-offset:5px}.ds-nav a:focus-visible{outline:2px solid #080e16;outline-offset:-5px}"
    },
    {
