      "html": "<a class=\"ds-panel\" href=\"#classes\"><h3>The next<br>generation.</h3><p>Children’s classes</p><span>Explore children’s classes</span></a>",
      "css": ".ds-panel{display:block;padding:24px;border-top:1px solid #080e16;border-radius:0;background:#48b5dd;color:#080e16;text-decoration:none}.ds-panel h3{margin:0;font:400 clamp(38px,4.2vw,65px)/1.05 \"TDE Condensed\",sans-serif;text-transform:uppercase;letter-spacing:-.015em}.ds-panel p{margin-top:15px;font:16px/1.7 Inter,sans-serif}.ds-panel span{display:block;margin-top:23px;padding-top:16px;border-top:1px solid #080e16;font:600 14px Inter,sans-serif}.ds-panel:hover h3{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:7px}.ds-panel:focus-visible{outline:2px solid #48b5dd;outline-offset:5px}"
