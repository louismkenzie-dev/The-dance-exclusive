{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "images": {
    "sizes": [
      480,
      768,
      1080,
      1440,
      1920
    ],
    "formats": [
      "image/webp"
    ],
    "qualities": [
      80
    ],
    "minimumCacheTTL": 3600,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "suwaetnsszlpaaykhpif.supabase.co",
        "pathname": "/storage/v1/object/public/workshop-media/**"
      }
    ]
  },
  "functions": {
    "api/render.js": {
      "includeFiles": "{dist/app.html,dist-ssr/**}",
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/adult-dance-classes", "destination": "/classes?type=adult", "permanent": true },
    { "source": "/kids-dance-classes", "destination": "/classes?type=children", "permanent": true },
    { "source": "/dance-classes", "destination": "/classes", "permanent": true },
    { "source": "/dance-workshops", "destination": "/events", "permanent": true },
    { "source": "/kids-dance-parties", "destination": "/parties", "permanent": true },
    { "source": "/dance-competitions", "destination": "/results", "permanent": true },
    { "source": "/uniform", "destination": "/shop", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/render?path=/" },
    { "source": "/:path*", "destination": "/api/render?path=/:path*" }
  ]
}
