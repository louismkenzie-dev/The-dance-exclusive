      "css": ".ds-town{display:grid;gap:20px;color:#e9f6fb;font:600 19px Inter,sans-serif;background:#080e16;padding:20px}.ds-town select{width:100%;min-height:56px;background:#061a2d;color:#eff9ff;border:1px solid #7fabbf;border-radius:8px;padding:12px;font:inherit}.ds-town select:focus-visible{outline:2px solid #48b5dd;outline-offset:5px}"
